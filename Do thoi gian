  // - CCTA: máy tính (3,6 mL/s; 47 mL ở 60 kg, IDR 0,021, 13 s) đang lệch với mục quy trình CCTA (4,5–5,5 mL/s; 60–80 mL).
};
/* ======================= HẾT PHẦN CẤU HÌNH ======================= */

(function(){
  "use strict";
  var $ = function(id){ return document.getElementById(id); };
  var STORE = "sotay-do-thoi-gian";
  var luot = null, idx = 0, t0 = 0, tick = null, giay = 0, ketQuaLuot = [];

  function loadAll(){ try { return JSON.parse(localStorage.getItem(STORE) || "[]"); } catch(e){ return []; } }
  function saveAll(a){ try { localStorage.setItem(STORE, JSON.stringify(a)); } catch(e){} }
  var tatCa = loadAll();          // bản lưu dự phòng trên máy (mọi lượt thử)
  var memAll = tatCa.slice();     // dùng khi trình duyệt không cho lưu
  var STORE_KS = "sotay-khao-sat";
  var ksAll = (function(){ try { return JSON.parse(localStorage.getItem(STORE_KS) || "[]"); } catch(e){ return []; } })();

  function show(id){ ["scrSetup","scrQ","scrSurvey","scrDone"].forEach(function(s){ $(s).classList.toggle("hide", s!==id); }); }
  function step(id){ ["stRead","stRun","stGrade"].forEach(function(s){ $(s).classList.toggle("hide", s!==id); }); }

  /* ---------- màn 1 ---------- */
  var chon = {};
  Array.prototype.forEach.call(document.querySelectorAll(".seg[data-f]"), function(g){
    g.addEventListener("click", function(e){
      var b = e.target.closest("button"); if(!b) return;
      Array.prototype.forEach.call(g.children, function(x){ x.classList.toggle("sel", x===b); });
      chon[g.getAttribute("data-f")] = b.textContent.trim();
    });
  });
  $("btnVao").onclick = function(){
    var ma = $("fMa").value.trim();
    if(!ma || !chon.thamNien || !chon.phuongPhap || !chon.boDe){ $("setupErr").textContent = "Cần điền mã người thử và chọn đủ Thâm niên, Phương pháp, Bộ đề."; return; }
    $("setupErr").textContent = "";
    luot = { ma: ma, giamSat: $("fGs").value.trim(), thamNien: chon.thamNien, phuongPhap: chon.phuongPhap, boDe: chon.boDe };
    idx = 0; ketQuaLuot = [];
    $("limTxt").textContent = GIOI_HAN_GIAY;
    showQ(); show("scrQ");
  };

  /* ---------- màn 2 ---------- */
  function deHienTai(){ return BO_DE[luot.boDe][idx]; }
  function showQ(){
    var n = BO_DE[luot.boDe].length, q = deHienTai();
    $("qPos").textContent = "Câu " + (idx+1) + "/" + n + " · " + q.ten;
    $("qWho").textContent = luot.ma + " · " + luot.phuongPhap + " · Bộ " + luot.boDe;
    $("qBar").style.width = (idx / n * 100) + "%";
    $("qText").textContent = q.de;
    $("clock").textContent = "0.0"; $("clock").className = "clock";
    $("fTraLoi").value = "";
    step("stRead");
  }
  $("btnStart").onclick = function(){
    t0 = performance.now(); step("stRun");
    tick = setInterval(function(){
      var s = (performance.now() - t0) / 1000;
      $("clock").textContent = s.toFixed(1);
      $("clock").className = "clock" + (s >= GIOI_HAN_GIAY*0.8 ? " warn" : "");
      if(s >= GIOI_HAN_GIAY){ dung(true); }
    }, 100);
  };
  function dung(quaGio){
    clearInterval(tick); tick = null;
    giay = quaGio ? GIOI_HAN_GIAY : Math.round((performance.now() - t0) / 100) / 10;
    $("clockFinal").textContent = giay.toFixed(1) + " s";
    $("clockFinal").className = "clock" + (quaGio ? " over" : "");
    step("stGrade");
    if(quaGio){ ghi("Không tìm được"); }
  }
  $("btnFound").onclick = function(){ dung(false); };
  $("btnGiveUp").onclick = function(){
    clearInterval(tick); tick = null;
    giay = GIOI_HAN_GIAY; ghi("Không tìm được");
  };
  $("btnSubmit").onclick = function(){
    if(!$("fTraLoi").value.trim()){ $("ansErr").textContent = "Cần ghi câu trả lời trước khi gửi."; return; }
    $("ansErr").textContent = "";
    ghi("Chưa chấm");
  };

  /* ---------- ghi kết quả ---------- */
  function ghi(kq){
    var q = deHienTai();
    var rec = {
      thoiDiem: new Date().toISOString(), maNguoiThu: luot.ma, giamSat: luot.giamSat,
      thamNien: luot.thamNien, phuongPhap: luot.phuongPhap, boDe: luot.boDe,
      cau: idx + 1, tenCau: q.ten, giay: giay, ketQua: kq, traLoi: $("fTraLoi").value.trim()
    };
    ketQuaLuot.push(rec);
    memAll.push(rec); saveAll(memAll);
    gui(rec);
    idx++;
    if(idx < BO_DE[luot.boDe].length){ showQ(); } else if(luot.boDe === "B"){ moKhaoSat(); } else { tongKet(); }
  }
  function gui(r){
    if(!LOG_URL) return;
    // Dùng đúng các trường log.js đang gửi (t, u, loai, id, ten, phanHe, page) để
    // Apps Script hiện tại vẫn ghi được dòng; thêm các trường riêng cho bản script mới.
    var body = {
      t: r.thoiDiem, u: r.maNguoiThu, loai: "do-thoi-gian",
      id: "bo" + r.boDe + "-cau" + r.cau,
      ten: "Câu " + r.cau + " | " + r.giay + " giây | " + r.ketQua + " | " + r.thamNien + " | GS " + (r.giamSat || "-"),
      phanHe: r.phuongPhap, page: "do-thoi-gian.html",
      maNguoiThu: r.maNguoiThu, giamSat: r.giamSat, thamNien: r.thamNien, phuongPhap: r.phuongPhap,
      boDe: r.boDe, cau: r.cau, tenCau: r.tenCau, giay: r.giay, ketQua: r.ketQua, traLoi: r.traLoi
    };
    try {
      fetch(LOG_URL, { method:"POST", mode:"no-cors", keepalive:true,
        headers:{ "Content-Type":"text/plain;charset=utf-8" }, body: JSON.stringify(body) }).catch(function(){});
    } catch(e){}
  }

  /* ---------- màn 2b: khảo sát (thang SUS 10 câu + đánh giá chung) ---------- */
  var SUS = [
    "Tôi nghĩ tôi sẽ muốn sử dụng Sổ tay điện tử thường xuyên.",
    "Tôi thấy Sổ tay phức tạp một cách không cần thiết.",
    "Tôi thấy Sổ tay dễ sử dụng.",
    "Tôi nghĩ tôi cần người hướng dẫn kỹ thuật mới sử dụng được Sổ tay.",
    "Tôi thấy các chức năng của Sổ tay được kết hợp tốt với nhau.",
    "Tôi thấy Sổ tay có quá nhiều điểm không thống nhất.",
    "Tôi nghĩ hầu hết đồng nghiệp sẽ học cách dùng Sổ tay rất nhanh.",
    "Tôi thấy Sổ tay rườm rà, khó dùng.",
    "Tôi cảm thấy tự tin khi sử dụng Sổ tay.",
    "Tôi phải học nhiều thứ trước khi có thể sử dụng được Sổ tay."
  ];
  // Nhãn 5 mức
  var THANG_DONG_Y   = ["Hoàn toàn không đồng ý", "Không đồng ý", "Phân vân", "Đồng ý", "Hoàn toàn đồng ý"];
  var THANG_HAI_LONG = ["Rất không hài lòng", "Không hài lòng", "Bình thường", "Hài lòng", "Rất hài lòng"];
  var EXTRA = [
    { k:"haiLong", q:"11. Mức độ hài lòng chung của anh/chị với Sổ tay điện tử", thang: THANG_HAI_LONG },
    { k:"tinCay",  q:"12. Nội dung Sổ tay đáng tin cậy, có thể áp dụng trong công việc", thang: THANG_DONG_Y }
  ];
  var TINH_HUONG = ["Kỹ thuật ít gặp, cần nhớ lại protocol", "Tính liều thuốc cản quang / eGFR", "Cấp cứu (phản vệ, thoát mạch, ngừng tuần hoàn)",
                    "Ca trực đêm / trực một mình", "Hướng dẫn KTV mới, sinh viên thực tập", "Ít có nhu cầu sử dụng"];
  var ks = {};
  function likert(key, text, thang){
    var d = document.createElement("div"); d.className = "lk"; d.id = "lk-" + key;
    d.innerHTML = "<p>" + esc(text) + "</p><div class='opts'>" + [1,2,3,4,5].map(function(v){
      return "<button type='button' data-v='" + v + "'><b>" + v + "</b><small>" + esc(thang[v-1]) + "</small></button>"; }).join("") + "</div>";
    d.querySelector(".opts").addEventListener("click", function(e){
      var b = e.target.closest("button"); if(!b) return;
      Array.prototype.forEach.call(this.children, function(x){ x.classList.toggle("sel", x===b); });
      ks[key] = +b.getAttribute("data-v"); d.classList.remove("miss");
    });
    return d;
  }
  function moKhaoSat(){
    ks = {};
    $("susBox").innerHTML = ""; $("extraBox").innerHTML = ""; $("fGopY").value = ""; $("svErr").textContent = "";
    SUS.forEach(function(q, i){ $("susBox").appendChild(likert("q" + (i+1), (i+1) + ". " + q, THANG_DONG_Y)); });
    EXTRA.forEach(function(x){ $("extraBox").appendChild(likert(x.k, x.q, x.thang)); });
    $("thBox").innerHTML = TINH_HUONG.map(function(t, i){ return "<label class='chk'><input type='checkbox' value='" + esc(t) + "'> " + esc(t) + "</label>"; }).join("");
    show("scrSurvey"); window.scrollTo(0,0);
  }
  $("btnSurvey").onclick = function(){
    var keys = SUS.map(function(_, i){ return "q" + (i+1); }).concat(EXTRA.map(function(x){ return x.k; }));
    var thieu = keys.filter(function(k){ return !ks[k]; });
    thieu.forEach(function(k){ $("lk-" + k).classList.add("miss"); });
    if(thieu.length){ $("svErr").textContent = "Còn " + thieu.length + " câu chưa chọn (tô đỏ)."; $("lk-" + thieu[0]).scrollIntoView({ block:"center" }); return; }
    var tong = 0;
    for(var i = 1; i <= 10; i++){ tong += (i % 2 ? ks["q"+i] - 1 : 5 - ks["q"+i]); }
    var rec = { thoiDiem: new Date().toISOString(), maNguoiThu: luot.ma, giamSat: luot.giamSat, thamNien: luot.thamNien,
      sus: tong * 2.5, haiLong: ks.haiLong, tinCay: ks.tinCay,
      tinhHuong: Array.prototype.filter.call(document.querySelectorAll("#thBox input"), function(c){ return c.checked; }).map(function(c){ return c.value; }).join("; "),
      gopY: $("fGopY").value.trim() };
    for(var j = 1; j <= 10; j++) rec["q" + j] = ks["q" + j];
    ksAll.push(rec); try { localStorage.setItem(STORE_KS, JSON.stringify(ksAll)); } catch(e){}
    if(LOG_URL){
      var body = { t: rec.thoiDiem, u: rec.maNguoiThu, loai: "khao-sat", id: "sus", ten: "SUS " + rec.sus + " | Hài lòng " + rec.haiLong + "/5",
        phanHe: "", page: "do-thoi-gian.html" };
      for(var k in rec) body[k] = rec[k];
      try { fetch(LOG_URL, { method:"POST", mode:"no-cors", keepalive:true, headers:{ "Content-Type":"text/plain;charset=utf-8" }, body: JSON.stringify(body) }).catch(function(){}); } catch(e){}
    }
    tongKet();
  };

  /* ---------- màn 3 ---------- */
  function tongKet(){
    $("doneSub").textContent = luot.ma + " · " + luot.thamNien + " · " + luot.phuongPhap + " · Bộ " + luot.boDe;
    $("doneBody").innerHTML = ketQuaLuot.map(function(r){
      var cls = r.ketQua === "Không tìm được" ? "t-ko" : "t-cho";
      return "<tr><td>" + r.cau + ". " + esc(r.tenCau) + "</td><td>" + r.giay.toFixed(1) + "</td><td><span class='tag " + cls + "'>" + r.ketQua + "</span></td></tr>";
    }).join("");
    $("sendNote").textContent = "Kết quả đã gửi về Google Sheets và lưu dự phòng trên máy này (" + memAll.length + " dòng). Nên tải CSV sau mỗi buổi thử để chắc chắn không mất dữ liệu.";
    show("scrDone");
  }
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]; }); }
  $("btnNext").onclick = function(){
    $("fMa").value = ""; chon = {};
    Array.prototype.forEach.call(document.querySelectorAll(".seg[data-f] button"), function(b){ b.classList.remove("sel"); });
    show("scrSetup"); window.scrollTo(0,0);
  };
  $("btnCsvKs").onclick = function(){
    var cols = ["thoiDiem","maNguoiThu","giamSat","thamNien","q1","q2","q3","q4","q5","q6","q7","q8","q9","q10","sus","haiLong","tinCay","tinhHuong","gopY"];
    taiCsv(cols, ksAll, "khao-sat-hai-long.csv");
  };
  function taiCsv(cols, rows, ten){
    var q = function(v){ v = v == null ? "" : String(v); return /[",\n;]/.test(v) ? '"' + v.replace(/"/g,'""') + '"' : v; };
    var csv = "\uFEFF" + cols.join(",") + "\n" + rows.map(function(r){ return cols.map(function(c){ return q(r[c]); }).join(","); }).join("\n");
    var a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([csv], { type:"text/csv;charset=utf-8" }));
    a.download = ten; document.body.appendChild(a); a.click(); a.remove();
  }
  $("btnCsv").onclick = function(){
    var cols = ["thoiDiem","maNguoiThu","giamSat","thamNien","phuongPhap","boDe","cau","tenCau","giay","ketQua","traLoi"];
    var q = function(v){ v = v == null ? "" : String(v); return /[",\n;]/.test(v) ? '"' + v.replace(/"/g,'""') + '"' : v; };
    var csv = "﻿" + cols.join(",") + "\n" + memAll.map(function(r){ return cols.map(function(c){ return q(r[c]); }).join(","); }).join("\n");
    var a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([csv], { type:"text/csv;charset=utf-8" }));
    a.download = "do-thoi-gian-tra-cuu.csv"; document.body.appendChild(a); a.click(); a.remove();
  };
})();
</script>
</body>
</html>
