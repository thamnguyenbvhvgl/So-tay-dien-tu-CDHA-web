<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Đo thời gian tra cứu – Sổ tay điện tử CĐHA</title>
<style>
  :root{--bg:#f4f6fa;--surface:#fff;--text:#0f172b;--soft:#526079;--line:#e2e8f0;
        --brand:#15509c;--brand-ink:#0e3a73;--wash:rgba(21,80,156,.08);--danger:#d81f26;--ok:#1b7f4b;--warn:#b26a00}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
  header{background:var(--surface);border-bottom:1px solid var(--line);padding:12px 16px}
  header b{color:var(--brand-ink);font-size:16px}
  header span{color:var(--soft);font-size:13px;margin-left:8px}
  main{max-width:720px;margin:20px auto 48px;padding:0 16px}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;margin-bottom:14px}
  h1{font-size:22px;margin:0 0 4px} h2{font-size:18px;margin:0 0 10px}
  p.sub{color:var(--soft);margin:0 0 16px;font-size:13.5px}
  label{display:block;font-size:13px;color:var(--soft);margin:12px 0 4px}
  input,select,textarea{width:100%;height:42px;border:1px solid var(--line);border-radius:9px;padding:0 12px;font:inherit;background:#fff;color:var(--text)}
  textarea{height:84px;padding:10px 12px;resize:vertical}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}
  .seg{display:flex;gap:8px;flex-wrap:wrap}
  .seg button{flex:1 1 120px}
  button{height:44px;border-radius:10px;border:1px solid var(--line);background:#fff;color:var(--text);font:inherit;font-weight:600;cursor:pointer;padding:0 16px}
  button.pri{background:var(--brand);border-color:var(--brand);color:#fff}
  button.big{height:64px;font-size:20px;width:100%}
  button.ok{background:var(--ok);border-color:var(--ok);color:#fff}
  button.no{background:var(--danger);border-color:var(--danger);color:#fff}
  button.sel{background:var(--wash);border-color:var(--brand);color:var(--brand-ink)}
  button:disabled{opacity:.45;cursor:not-allowed}
  .q{font-size:19px;font-weight:600;margin:6px 0 14px}
  .meta{display:flex;justify-content:space-between;color:var(--soft);font-size:13px}
  .clock{font-size:64px;font-weight:800;text-align:center;font-variant-numeric:tabular-nums;letter-spacing:-.02em;margin:10px 0}
  .clock.warn{color:var(--warn)} .clock.over{color:var(--danger)}
  .bar{height:6px;background:var(--line);border-radius:99px;overflow:hidden;margin-bottom:16px}
  .bar i{display:block;height:100%;background:var(--brand);width:0}
  .key{background:var(--wash);border-left:4px solid var(--brand);border-radius:8px;padding:10px 12px;margin:12px 0;font-size:14px}
  .hint{font-size:13px;color:var(--soft)}
  .err{color:var(--danger);font-size:13px;min-height:18px;margin-top:8px}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{border-bottom:1px solid var(--line);padding:8px 6px;text-align:left}
  th{color:var(--soft);font-weight:600}
  .tag{display:inline-block;padding:1px 8px;border-radius:99px;font-size:12px;font-weight:700}
  .t-dung{background:#e3f4ea;color:var(--ok)} .t-sai{background:#fde6e6;color:var(--danger)} .t-ko{background:#fff1dc;color:var(--warn)} .t-cho{background:var(--wash);color:var(--brand-ink)}
  .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
  .hide{display:none}
  .lk{border-top:1px solid var(--line);padding:12px 0}
  .lk p{margin:0 0 8px;font-weight:600}
  .lk .opts{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
  .lk .opts button{height:auto;min-height:58px;padding:6px 2px;font-size:15px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;line-height:1.2}
  .lk .opts button small{font-size:11.5px;font-weight:500;color:var(--soft)}
  .lk .opts button.sel small{color:var(--brand-ink)}
  .chk{display:flex;align-items:center;gap:10px;padding:8px 0;font-size:15px}
  .chk input{width:20px;height:20px;flex:none}
  .lk.miss{background:#fde6e6;border-radius:8px;padding:12px 8px}
</style>
</head>
<body>
<header><b>Đo thời gian tra cứu</b><span>Sổ tay điện tử CĐHA · BV Hùng Vương Gia Lai</span></header>
<main>

<!-- ===================== MÀN 1: THÔNG TIN ===================== -->
<section id="scrSetup" class="card">
  <h1>Thông tin lượt thử</h1>
  <p class="sub">Người giám sát điền trước khi người thử bắt đầu. Không ghi họ tên, chỉ ghi mã.</p>
  <div class="row">
    <div><label>Mã người thử *</label><input id="fMa" placeholder="VD: KTV01" autocomplete="off"></div>
    <div><label>Người giám sát</label><input id="fGs" placeholder="VD: GS01" autocomplete="off"></div>
  </div>
  <label>Thâm niên *</label>
  <div class="seg" data-f="thamNien"><button>&lt; 2 năm</button><button>2–5 năm</button><button>&gt; 5 năm</button></div>
  <label>Phương pháp tra cứu *</label>
  <div class="seg" data-f="phuongPhap"><button>Tài liệu giấy/Word</button><button>Sổ tay điện tử</button></div>
  <label>Bộ đề *</label>
  <div class="seg" data-f="boDe"><button>A</button><button>B</button></div>
  <div class="err" id="setupErr"></div>
  <div class="actions"><button class="pri" id="btnVao">Vào bài →</button></div>
</section>

<!-- ===================== MÀN 2: CÂU HỎI ===================== -->
<section id="scrQ" class="card hide">
  <div class="meta"><span id="qPos">Câu 1/5</span><span id="qWho"></span></div>
  <div class="bar"><i id="qBar"></i></div>
  <div class="q" id="qText"></div>

  <!-- bước a: đọc đề -->
  <div id="stRead">
    <p class="hint">Đọc kỹ đề. Đồng hồ <b>chưa chạy</b>. Khi sẵn sàng tra cứu, bấm Bắt đầu.</p>
    <button class="pri big" id="btnStart">▶ Bắt đầu</button>
  </div>

  <!-- bước b: đang tra -->
  <div id="stRun" class="hide">
    <div class="clock" id="clock">0.0</div>
    <p class="hint" style="text-align:center">Giới hạn <span id="limTxt"></span> giây. Tra bằng phương pháp đã chọn.</p>
    <button class="ok big" id="btnFound">✓ Đã tìm thấy</button>
    <div class="actions"><button id="btnGiveUp">Không tìm được</button></div>
  </div>

  <!-- bước c: thí sinh ghi câu trả lời (không hiện đáp án) -->
  <div id="stGrade" class="hide">
    <div class="clock" id="clockFinal"></div>
    <p class="hint" style="text-align:center">Đồng hồ đã dừng. Thời gian ghi câu trả lời không tính vào kết quả.</p>
    <label>Câu trả lời của bạn *</label>
    <textarea id="fTraLoi" placeholder="Ghi đủ các ý đề yêu cầu"></textarea>
    <div class="err" id="ansErr"></div>
    <div class="actions"><button class="pri big" id="btnSubmit">Gửi câu trả lời →</button></div>
  </div>
</section>

<!-- ===================== MÀN 2b: KHẢO SÁT HÀI LÒNG ===================== -->
<section id="scrSurvey" class="card hide">
  <h2>Khảo sát mức độ hài lòng với Sổ tay điện tử</h2>
  <p class="sub">Khoảng 3 phút. Không có câu trả lời đúng hay sai; xin trả lời theo cảm nhận thật của anh/chị sau khi đã dùng Sổ tay. Kết quả chỉ dùng để cải tiến Sổ tay.</p>
  <h3 style="font-size:15px;margin:8px 0 0">Phần 1. Mức độ dễ sử dụng</h3>
  <p class="hint" style="margin:2px 0 4px">Mỗi câu chọn 1 mức: 1 Hoàn toàn không đồng ý · 2 Không đồng ý · 3 Phân vân · 4 Đồng ý · 5 Hoàn toàn đồng ý</p>
  <div id="susBox"></div>
  <h3 style="font-size:15px;margin:16px 0 0">Phần 2. Đánh giá chung</h3>
  <div id="extraBox"></div>
  <div class="lk"><p>13. Anh/chị sẽ mở Sổ tay trong những tình huống nào? (chọn nhiều)</p><div id="thBox"></div></div>
  <div class="lk"><p>14. Góp ý để Sổ tay tốt hơn (không bắt buộc)</p><textarea id="fGopY" placeholder="Nội dung còn thiếu, khó tìm, cần sửa…"></textarea></div>
  <div class="err" id="svErr"></div>
  <div class="actions"><button class="pri big" id="btnSurvey">Gửi khảo sát →</button></div>
</section>

<!-- ===================== MÀN 3: TỔNG KẾT ===================== -->
<section id="scrDone" class="card hide">
  <h2>Hoàn thành lượt thử</h2>
  <p class="hint">Câu trả lời sẽ được chấm sau theo barem của khoa.</p>
  <p class="sub" id="doneSub"></p>
  <table><thead><tr><th>Câu</th><th>Thời gian (giây)</th><th>Trạng thái</th></tr></thead><tbody id="doneBody"></tbody></table>
  <div class="actions">
    <button class="pri" id="btnNext">Lượt thử tiếp theo</button>
    <button id="btnCsv">⬇ Tải CSV toàn bộ</button>
    <button id="btnCsvKs">⬇ Tải CSV khảo sát</button>
  </div>
  <p class="hint" id="sendNote" style="margin-top:12px"></p>
</section>

</main>
<script>
/* ============================================================================
   CẤU HÌNH — SỬA Ở ĐÂY
   ----------------------------------------------------------------------------
   ĐÁP ÁN KHÔNG ĐỂ TRONG FILE NÀY (trang công khai, xem được mã nguồn).
   Barem chấm nằm ở file riêng "dap-an-cham-diem.csv" — chỉ người chấm giữ.
   Bộ A và Bộ B: cùng dạng câu, cùng số ý chấm (xem barem).
   ============================================================================ */
var GIOI_HAN_GIAY = 180;

// Cùng địa chỉ Apps Script mà assets/log.js đang dùng (nhật ký tra cứu).
var LOG_URL = "https://script.google.com/macros/s/AKfycby2zbmite7p5xRvUBmzJvX9edJK5HVuzc2BYiUJrY9-avZYXY-UwCdhwP1CrcwF8_uw/exec";

var BO_DE = {
  // BỘ ĐỀ A — dùng cho lượt đo Trước (Pre-test)
